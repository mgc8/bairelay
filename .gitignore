# Created by https://www.gitignore.io/api/rust
# Edit at https://www.gitignore.io/?templates=rust

### Rust ###
# Generated by Cargo
# will have compiled files and executables
/target/

# These are backup files generated by rustfmt
**/*.rs.bk

# End of https://www.gitignore.io/api/rust

# macOS
.DS_Store

# Real config contains credentials — use sample_config.toml as a template
config.toml

# Test-rig bairelay config (camera UIDs / passwords). Seed once from
# tests/bairelay-test.toml.example; ha-up.sh / ha-verify.sh use this.
tests/bairelay-test.toml

# Vendored third-party test binaries (install locally; not committed).
/tests/scripts/go2rtc/
# Transient output from tests/scripts/manual-verify.sh
/target/manual-verify/
# Test-harness transient output + colima state markers.
# tests/logs/README.md is tracked; everything else under tests/logs/
# is generated at runtime.
/tests/logs/*
!/tests/logs/README.md

# Hand-captured live-camera fixtures (BcMedia dumps, abilityInfo XML
# captures, anything else operator-specific) are not committed — they
# are per-camera, may carry privacy-sensitive content, and drift with
# firmware. README stays tracked so the dir's purpose isn't lost.
/tests/fixtures/*
!/tests/fixtures/README.md

# Self-signed test PKI generated by tests/scripts/gen-test-certs.sh.
# Used by manual-verify.sh --tls; tests/rtsp/tests/tls_handshake.rs
# mints its own ephemeral certs via rcgen and does NOT depend on these.
tests/test-certs/

# Self-signed cert + key for the pushx.reolink.com sniff harness. Run
# tests/scripts/pushx-sink/run.sh to regenerate; do not commit a private
# key into git regardless of how throwaway it looks.
tests/scripts/pushx-sink/cert.pem
tests/scripts/pushx-sink/key.pem

# Author-rewrite mailmap. Standard git mailmap format
# (see `man gitmailmap`); contents are operator-specific.
.publish-mailmap

# HA test-rig runtime state — regenerated by ha-up.sh / ha-verify.sh.
# Recorder DB carries entity_id history with no value to public users;
# logs, lock, and core.restore_state churn on every state change.
tests/scripts/ha-config/home-assistant_v2.db
tests/scripts/ha-config/home-assistant_v2.db-wal
tests/scripts/ha-config/home-assistant_v2.db-shm
tests/scripts/ha-config/home-assistant.log
tests/scripts/ha-config/home-assistant.log.*
tests/scripts/ha-config/.ha_run.lock
tests/scripts/ha-config/.storage/core.restore_state
tests/scripts/ha-config/.storage/core.device_registry
tests/scripts/ha-config/.storage/core.entity_registry
tests/scripts/ha-config/.storage/http

# `cargo tarpaulin --out xml`/`--out html` writes these at the project
# root when run locally. Regenerated on every coverage run; in CI the
# Cobertura XML is uploaded as a workflow artifact instead.
cobertura.xml
tarpaulin-report.html
